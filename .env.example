# REQUIRED - Application will fail to start without these
JWT_SECRET=your_super_secret_random_string_min_32_chars_here
MONGODB_URI=mongodb://localhost:27017/blogify

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (optional - app runs in degraded mode without it)
REDIS_URL=redis://localhost:6379

# Email (optional - notifications disabled without it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS (production only)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Environment
NODE_ENV=production
PORT=8000
